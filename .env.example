# -----------------------------------------------------------------------------
# Supabase (Project Settings → API)
# -----------------------------------------------------------------------------
# Públicas (podem ir para o navegador; protegidas por RLS)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-ou-publishable

# PRIVADA: usada apenas no servidor (criação de funcionários e seed).
# NUNCA prefixe com NEXT_PUBLIC_ e nunca exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role

# -----------------------------------------------------------------------------
# Aplicação
# -----------------------------------------------------------------------------
# URL pública usada nos QR Codes (ex.: https://seu-restaurante.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ID do restaurante atendido por esta instalação (seed usa o valor abaixo)
NEXT_PUBLIC_RESTAURANT_ID=00000000-0000-4000-a000-000000000001

# Modo demonstração: exibe página inicial com atalhos, credenciais e links de mesas.
# Defina como "false" em produção.
NEXT_PUBLIC_DEMO_MODE=true

# Senha padrão dos usuários criados por `npm run seed:demo`
DEMO_PASSWORD=Demo@1234

# -----------------------------------------------------------------------------
# Testes de banco (opcional): PostgreSQL local preparado por `npm run db:local:setup`
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/restaurante_test
